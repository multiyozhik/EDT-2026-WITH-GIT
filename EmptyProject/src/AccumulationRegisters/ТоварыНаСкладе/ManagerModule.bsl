// Возвращает остатки номенклатуры по складам.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура - номенклатура, по которой получаются остатки.
//
// Возвращаемое значение:
//   Соответствие:
//     * Ключ - Строка - склад, на котором числится остаток.
//     * Значение - Число - количество остатка номенклатуры на складе.
Функция ОстатокНоменклатуры(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТоварыНаСкладе.Склад КАК Склад,
	|	ТоварыНаСкладе.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладе.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладе.Остатки(, Номенклатура = &Номенклатура, ) КАК ТоварыНаСкладе";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Остаток = Новый Соответствие;
	Для Каждого Строка Из Результат Цикл
		Остаток.Вставить(Строка.Склад, Строка.КоличествоОстаток);
	КонецЦикла;
	Возврат Остаток;
	
	МойJson = "[
	|	{
	|		""price"" = 10,
	|		""art"" = ""sadff156""
	|	},
	|	{// Преобразует JSON-массив объектов {price, art} в массив структур.
//
// Параметры:
//  СтрокаJSON - Строка - JSON в формате массива объектов.
//
// Возвращаемое значение:
//  Массив из Структура - элементы с полями price (Число) и art (Строка);
//           пустой массив, если JSON не является массивом.
Функция ТоварыИзJSON(СтрокаJSON) Экспорт
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Результат = Новый Массив;
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТовара = Новый Структура("price, art", 0, "");
		Если ТипЗнч(Элемент) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТовара, Элемент);
		КонецЕсли;
		Результат.Добавить(СтрокаТовара);
	КонецЦикла;

	Возврат Результат;
КонецФункции

	|		""price"" = 20,
	|		""art"" = ""qqq656""
	|	}
	|]";
	
	
КонецФункции


#КонецОбласти

#КонецЕсли
